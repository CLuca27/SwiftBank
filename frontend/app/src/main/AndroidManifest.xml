<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".SwiftBankApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwiftBank"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".activities.login.SessionRevokedActivity"
            android:exported="false" />
        <activity
            android:name=".activities.login.BlockedUserActivity"
            android:exported="false" />
        <activity
            android:name=".activities.dashboard.DashboardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.exchange.ExchangeActivity"
            android:exported="false" />
        <activity
            android:name=".activities.settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.settings.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".activities.transfer.TransferActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.transfer.BeneficiariesActivity"
            android:exported="false" />
        <activity
            android:name=".activities.transfer.AddBeneficiaryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.transfer.TransferAmountActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.send.SendOptionsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.bills.BillCategoriesActivity"
            android:exported="false" />
        <activity
            android:name=".activities.bills.SavedBillersActivity"
            android:exported="false" />
        <activity
            android:name=".activities.bills.BillersActivity"
            android:exported="false" />
        <activity
            android:name=".activities.bills.BillPaymentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.login.LoginPinActivity"
            android:exported="false" />
        <activity
            android:name=".activities.login.ResetPinOtpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.login.ResetPinSetActivity"
            android:exported="false" />
        <activity
            android:name=".activities.settings.ChangePinActivity"
            android:exported="false" />
        <activity
            android:name=".activities.register.RegisterPinActivity"
            android:exported="false" />
        <activity
            android:name=".activities.login.IdentifyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.register.RegisterDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.register.BackActivity"
            android:exported="false" />
        <activity
            android:name=".activities.register.RegisterEmailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.register.OtpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.register.RegisterPhoneActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.welcome.WelcomeActivity"
            android:exported="false" />
        <activity
            android:name=".activities.cards.CardsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.cards.CardDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.cards.CardDesignActivity"
            android:exported="false" />
        <activity
            android:name=".activities.cards.CardPaymentApprovalActivity"
            android:exported="false" />
        <activity
            android:name=".activities.transactions.TransactionsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.transactions.TransactionDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.statistics.StatisticsActivity"
            android:exported="false" />
        <activity
            android:name=".activities.splash.SplashActivity"
            android:theme="@style/Theme.SwiftBank.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider for camera photos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase Messaging Service -->
        <service
            android:name=".services.SwiftBankMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
