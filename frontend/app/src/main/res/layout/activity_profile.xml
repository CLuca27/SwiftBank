<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_circular"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Profilul meu"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- SKELETON LOADING -->
            <LinearLayout
                android:id="@+id/skeletonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="visible">

                <!-- Profile Photo Skeleton -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="24dp">

                    <com.example.swiftbank.views.SkeletonView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        app:skeleton_radius="60dp" />

                    <com.example.swiftbank.views.SkeletonView
                        android:layout_width="160dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="16dp"
                        app:skeleton_radius="4dp" />

                    <com.example.swiftbank.views.SkeletonView
                        android:layout_width="120dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="8dp"
                        app:skeleton_radius="4dp" />

                </LinearLayout>

                <!-- Personal Info Skeleton -->
                <com.example.swiftbank.views.SkeletonView
                    android:layout_width="140dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    app:skeleton_radius="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.example.swiftbank.views.SkeletonView
                        android:layout_width="80dp"
                        android:layout_height="12dp"
                        app:skeleton_radius="4dp" />

                    <com.example.swiftbank.views.SkeletonView
                        android:layout_width="120dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="8dp"
                        app:skeleton_radius="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/divider_color" />

                    <com.example.swiftbank.views.SkeletonView
                        android:layout_width="60dp"
                        android:layout_height="12dp"
                        app:skeleton_radius="4dp" />

                    <com.example.swiftbank.views.SkeletonView
                        android:layout_width="140dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="8dp"
                        app:skeleton_radius="4dp" />

                </LinearLayout>

                <!-- Contact Skeleton -->
                <com.example.swiftbank.views.SkeletonView
                    android:layout_width="80dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    app:skeleton_radius="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.example.swiftbank.views.SkeletonView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        app:skeleton_radius="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/divider_color" />

                    <com.example.swiftbank.views.SkeletonView
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        app:skeleton_radius="8dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ACTUAL CONTENT -->
            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <!-- Profile Photo Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="24dp">

                    <!-- Photo Container -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp">

                        <!-- Avatar with Initials (fallback) -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardInitials"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            app:cardCornerRadius="60dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="@color/green_accent">

                            <TextView
                                android:id="@+id/tvInitials"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:textColor="@color/white"
                                android:textSize="40sp"
                                android:textStyle="bold"
                                tools:text="LC" />

                        </androidx.cardview.widget.CardView>

                        <!-- Profile Photo -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardPhoto"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:visibility="gone"
                            app:cardCornerRadius="60dp"
                            app:cardElevation="4dp">

                            <ImageView
                                android:id="@+id/ivProfilePhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop" />

                        </androidx.cardview.widget.CardView>

                        <!-- Edit Button -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnChangePhoto"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="bottom|end"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="4dp"
                            app:cardBackgroundColor="@color/card_background">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/white" />

                        </androidx.cardview.widget.CardView>

                    </FrameLayout>

                    <!-- Name Display -->
                    <TextView
                        android:id="@+id/tvFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Lucas Cojocaru" />

                    <TextView
                        android:id="@+id/tvMemberSince"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white_60"
                        android:textSize="14sp"
                        tools:text="Membru din aprilie 2024" />

                </LinearLayout>

                <!-- Basic Info Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="Informații de bază"
                    android:textColor="@color/green_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- First Name -->
                    <LinearLayout
                        android:id="@+id/fieldFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_item"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Prenume"
                                android:textColor="@color/white_60"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvFirstName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                tools:text="Lucas" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/white_40" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:background="@color/divider_color" />

                    <!-- Last Name -->
                    <LinearLayout
                        android:id="@+id/fieldLastName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_item"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nume"
                                android:textColor="@color/white_60"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvLastName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                tools:text="Cojocaru" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/white_40" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:background="@color/divider_color" />

                    <!-- Birth Date (read-only) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_item"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Data nașterii"
                                android:textColor="@color/white_60"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvBirthDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                tools:text="27 aprilie 2004" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Contact Info Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:text="Contact"
                    android:textColor="@color/green_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- Email (read-only) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_item"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_email"
                            app:tint="@color/white_60" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Email"
                                android:textColor="@color/white_60"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                tools:text="lucas@example.com" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/white_20" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="56dp"
                        android:background="@color/divider_color" />

                    <!-- Phone (read-only) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_item"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/white_60" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Telefon"
                                android:textColor="@color/white_60"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvPhone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                tools:text="+40 723 456 789" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/white_20" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Address Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:text="Adresa de reședință"
                    android:textColor="@color/green_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- Address (read-only) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_item"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/white_60" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Adresă"
                                android:textColor="@color/white_60"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvAddress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                tools:text="Strada Exemplu, Nr. 10, București" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

            </LinearLayout>

        </FrameLayout>

    </ScrollView>

</LinearLayout>
