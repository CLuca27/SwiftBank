<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_circular"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Mega Image" />

        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_circular"
            android:padding="10dp"
            android:src="@drawable/ic_more"
            app:tint="@color/white" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Loading State -->
        <LinearLayout
            android:id="@+id/loadingState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/green_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Se încarcă..."
                android:textColor="@color/white_60"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Content -->
        <ScrollView
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Icon & Amount Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="24dp">

                    <!-- Icon -->
                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardIcon"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardBackgroundColor="@color/white_10"
                            app:cardCornerRadius="36dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/ivIcon"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_shopping"
                                app:tint="@color/white" />

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardInitials"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/green_accent"
                            app:cardCornerRadius="36dp"
                            app:cardElevation="0dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <TextView
                                    android:id="@+id/tvInitials"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:textColor="@color/white"
                                    android:textSize="24sp"
                                    android:textStyle="bold"
                                    tools:text="MI" />

                                <ImageView
                                    android:id="@+id/ivSenderPhoto"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone" />

                            </FrameLayout>

                        </androidx.cardview.widget.CardView>

                        <FrameLayout
                            android:id="@+id/exchangeIconContainer"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:visibility="gone">

                            <androidx.cardview.widget.CardView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="top|start"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/ivFlagFrom"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/flag_ro" />

                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="bottom|end"
                                app:cardCornerRadius="23dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/ivFlagTo"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/flag_eur" />

                            </androidx.cardview.widget.CardView>

                        </FrameLayout>

                    </FrameLayout>

                    <!-- Amount -->
                    <TextView
                        android:id="@+id/tvAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/white"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        tools:text="-9,39 lei" />

                    <!-- Status -->
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/green_accent"
                        android:textSize="14sp"
                        tools:text="Finalizată" />

                    <!-- Date -->
                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white_60"
                        android:textSize="14sp"
                        tools:text="28 aprilie 2026, 13:41" />

                </LinearLayout>

                <!-- Payment Info Section -->
                <LinearLayout
                    android:id="@+id/sectionPaymentInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <!-- Account -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cont"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvAccountName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/blue_accent"
                                android:textSize="14sp"
                                tools:text="Personal" />

                            <TextView
                                android:id="@+id/tvAccountSeparator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="4dp"
                                android:text="&#183;"
                                android:textColor="@color/blue_accent"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvAccountCurrency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/blue_accent"
                                android:textSize="14sp"
                                tools:text="RON" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Card Info Section -->
                <LinearLayout
                    android:id="@+id/sectionCardInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Detalii comerciant"
                        android:textColor="@color/green_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Merchant Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Comerciant"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvMerchantName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="Mega Image" />

                    </LinearLayout>

                    <!-- Location -->
                    <LinearLayout
                        android:id="@+id/rowLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Locație"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="București, România" />

                    </LinearLayout>

                    <!-- Card Used -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Card"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvCardUsed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="•••• 7173" />

                    </LinearLayout>

                    <!-- Category -->
                    <LinearLayout
                        android:id="@+id/rowCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Categorie"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivCategoryIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="6dp"
                                android:src="@drawable/ic_category_shopping"
                                app:tint="@color/white_60" />

                            <TextView
                                android:id="@+id/tvCategoryName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                tools:text="Cumpărături" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Card Reference -->
                    <LinearLayout
                        android:id="@+id/rowCardReference"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Referință"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvCardReference"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="TXN-123456" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Transfer Info Section -->
                <LinearLayout
                    android:id="@+id/sectionTransferInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Detalii transfer"
                        android:textColor="@color/green_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Beneficiary -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/tvBeneficiaryLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Beneficiar"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvBeneficiaryName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="Matei Ionescu" />

                    </LinearLayout>

                    <!-- IBAN -->
                    <LinearLayout
                        android:id="@+id/rowIban"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="IBAN"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvIban"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="RO49 SWIFT 0001 2345 6789" />

                    </LinearLayout>

                    <!-- Bank -->
                    <LinearLayout
                        android:id="@+id/rowBankName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Bancă"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvBankName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="SwiftBank" />

                    </LinearLayout>

                    <!-- Description -->
                    <LinearLayout
                        android:id="@+id/rowDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Descriere"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="Pentru cafea" />

                    </LinearLayout>

                    <!-- Reference -->
                    <LinearLayout
                        android:id="@+id/rowReference"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Referință"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvReference"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="TRF-2024-001" />

                    </LinearLayout>

                    <!-- Transfer Category -->
                    <LinearLayout
                        android:id="@+id/rowTransferCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvTransferCategoryLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tip"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivTransferCategoryIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="6dp"
                                android:src="@drawable/ic_exchange"
                                app:tint="@color/white_60" />

                            <TextView
                                android:id="@+id/tvTransferCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                tools:text="Schimb valutar" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Bill Info Section -->
                <LinearLayout
                    android:id="@+id/sectionBillInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Detalii plată"
                        android:textColor="@color/green_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Biller -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Furnizor"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvBillerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="ENEL" />

                    </LinearLayout>

                    <!-- Category -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Categorie"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivBillerCategoryIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="6dp"
                                android:src="@drawable/ic_category_utilities"
                                app:tint="@color/white_60" />

                            <TextView
                                android:id="@+id/tvBillerCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                tools:text="Utilități" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Client Code -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cod client"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvClientCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="123456789" />

                    </LinearLayout>

                    <!-- Invoice Reference -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Referință"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvInvoiceRef"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="INV-2024-001" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Amount Breakdown Section -->
                <LinearLayout
                    android:id="@+id/sectionAmountBreakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Detalii sumă"
                        android:textColor="@color/green_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Original Amount (for currency conversion) -->
                    <LinearLayout
                        android:id="@+id/rowOriginalAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvOriginalAmountLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sumă originală"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvOriginalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="10,00 €" />

                    </LinearLayout>

                    <!-- Exchange rate -->
                    <LinearLayout
                        android:id="@+id/rowExchangeRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Curs valutar"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvExchangeRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="1 RON = 0,1916 EUR" />

                    </LinearLayout>

                    <!-- Fees -->
                    <LinearLayout
                        android:id="@+id/rowFees"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Comisioane"
                            android:textColor="@color/white_60"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvFees"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/green_accent"
                            android:textSize="14sp"
                            tools:text="Fără comision" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="@color/divider_color" />

                    <!-- Total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/tvTotalAmountLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sumă totală"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="9,39 lei" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</LinearLayout>
