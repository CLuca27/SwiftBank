<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/gradient_splash_background">

    <com.example.swiftbank.views.ParticlesView
        android:id="@+id/particlesView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Back Button -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_icon_circle_subtle"
        android:clickable="true"
        android:contentDescription="Înapoi"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title Section -->
    <LinearLayout
        android:id="@+id/titleSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pin_title_top_margin"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Creează un cod PIN"
            android:textColor="@color/white"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Alege 6 cifre pentru a-ți securiza contul"
            android:textColor="@color/white_70"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- PIN Dots Container -->
    <LinearLayout
        android:id="@+id/dotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pin_dots_top_margin"
        android:gravity="center"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleSection">

        <View
            android:id="@+id/dot1"
            android:layout_width="@dimen/pin_dot_size"
            android:layout_height="@dimen/pin_dot_size"
            android:layout_marginHorizontal="@dimen/pin_dot_margin"
            android:background="@drawable/pin_dot_empty" />

        <View
            android:id="@+id/dot2"
            android:layout_width="@dimen/pin_dot_size"
            android:layout_height="@dimen/pin_dot_size"
            android:layout_marginHorizontal="@dimen/pin_dot_margin"
            android:background="@drawable/pin_dot_empty" />

        <View
            android:id="@+id/dot3"
            android:layout_width="@dimen/pin_dot_size"
            android:layout_height="@dimen/pin_dot_size"
            android:layout_marginHorizontal="@dimen/pin_dot_margin"
            android:background="@drawable/pin_dot_empty" />

        <View
            android:id="@+id/dot4"
            android:layout_width="@dimen/pin_dot_size"
            android:layout_height="@dimen/pin_dot_size"
            android:layout_marginHorizontal="@dimen/pin_dot_margin"
            android:background="@drawable/pin_dot_empty" />

        <View
            android:id="@+id/dot5"
            android:layout_width="@dimen/pin_dot_size"
            android:layout_height="@dimen/pin_dot_size"
            android:layout_marginHorizontal="@dimen/pin_dot_margin"
            android:background="@drawable/pin_dot_empty" />

        <View
            android:id="@+id/dot6"
            android:layout_width="@dimen/pin_dot_size"
            android:layout_height="@dimen/pin_dot_size"
            android:layout_marginHorizontal="@dimen/pin_dot_margin"
            android:background="@drawable/pin_dot_empty" />

    </LinearLayout>

    <!-- Biometric Icon (pentru login, ascuns la register) -->
    <ImageView
        android:id="@+id/btnBiometric"
        android:layout_width="@dimen/pin_biometric_size"
        android:layout_height="@dimen/pin_biometric_size"
        android:layout_marginStart="24dp"
        android:clickable="true"
        android:contentDescription="Autentificare biometrică"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_fingerprint"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/dotsContainer"
        app:layout_constraintStart_toEndOf="@id/dotsContainer"
        app:layout_constraintTop_toTopOf="@id/dotsContainer" />

    <!-- Error Message -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#FF6B6B"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dotsContainer" />

    <!-- Numpad -->
    <GridLayout
        android:id="@+id/numpadGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/pin_numpad_bottom_margin"
        android:columnCount="3"
        android:rowCount="4"
        app:layout_constraintBottom_toTopOf="@id/tvForgotPin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Row 1 -->
        <TextView
            android:id="@+id/btn1"
            style="@style/NumpadButton"
            android:text="1" />

        <TextView
            android:id="@+id/btn2"
            style="@style/NumpadButton"
            android:text="2" />

        <TextView
            android:id="@+id/btn3"
            style="@style/NumpadButton"
            android:text="3" />

        <!-- Row 2 -->
        <TextView
            android:id="@+id/btn4"
            style="@style/NumpadButton"
            android:text="4" />

        <TextView
            android:id="@+id/btn5"
            style="@style/NumpadButton"
            android:text="5" />

        <TextView
            android:id="@+id/btn6"
            style="@style/NumpadButton"
            android:text="6" />

        <!-- Row 3 -->
        <TextView
            android:id="@+id/btn7"
            style="@style/NumpadButton"
            android:text="7" />

        <TextView
            android:id="@+id/btn8"
            style="@style/NumpadButton"
            android:text="8" />

        <TextView
            android:id="@+id/btn9"
            style="@style/NumpadButton"
            android:text="9" />

        <!-- Row 4 -->
        <View
            android:layout_width="@dimen/pin_numpad_button_size"
            android:layout_height="@dimen/pin_numpad_button_size"
            android:layout_margin="@dimen/pin_numpad_button_margin" />

        <TextView
            android:id="@+id/btn0"
            style="@style/NumpadButton"
            android:text="0" />

        <ImageView
            android:id="@+id/btnBackspace"
            android:layout_width="@dimen/pin_numpad_button_size"
            android:layout_height="@dimen/pin_numpad_button_size"
            android:layout_margin="@dimen/pin_numpad_button_margin"
            android:background="@drawable/numpad_button_background"
            android:clickable="true"
            android:contentDescription="Șterge"
            android:focusable="true"
            android:padding="@dimen/pin_numpad_backspace_padding"
            android:src="@drawable/ic_backspace" />

    </GridLayout>

    <!-- Forgot PIN (pentru login, ascuns la register) -->
    <TextView
        android:id="@+id/tvForgotPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/pin_forgot_bottom_margin"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:text="Ai uitat PIN-ul?"
        android:textColor="@color/white_70"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="@dimen/pin_loading_size"
            android:layout_height="@dimen/pin_loading_size"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
