<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_circular"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Transfer"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- FROM Account Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Din contul"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Account Skeleton (shows while loading) -->
            <LinearLayout
                android:id="@+id/accountSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="visible">

                <View
                    android:layout_width="32dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_skeleton" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <View
                        android:layout_width="100dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="140dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_skeleton" />

                </LinearLayout>

            </LinearLayout>

            <!-- Account Content (visible after loading) -->
            <LinearLayout
                android:id="@+id/selectorFromAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ivFlagFrom"
                    android:layout_width="32dp"
                    android:layout_height="24dp"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/flag_ro" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFromAccountName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Personal RON" />

                    <TextView
                        android:id="@+id/tvFromAccountBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="Sold: 1.500,00 lei" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="@color/text_hint" />

            </LinearLayout>

            <!-- TO IBAN Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Către"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- IBAN Skeleton -->
            <LinearLayout
                android:id="@+id/skeletonIban"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:visibility="visible">

                <View
                    android:layout_width="180dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_skeleton" />

            </LinearLayout>

            <!-- IBAN Content -->
            <LinearLayout
                android:id="@+id/cardIban"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <EditText
                    android:id="@+id/etIban"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="IBAN"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/white_50"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/progressIban"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/accent_soft_blue"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/ivIbanValid"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone"
                    app:tint="@color/success_green"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Bank Info (appears after IBAN validation) -->
            <LinearLayout
                android:id="@+id/layoutBankInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ivBankIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_bank"
                    app:tint="@color/accent_soft_blue" />

                <TextView
                    android:id="@+id/tvBankName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/accent_soft_blue"
                    android:textSize="13sp"
                    tools:text="SwiftBank" />

            </LinearLayout>

            <!-- Beneficiary Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Nume beneficiar"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Beneficiary Skeleton -->
            <LinearLayout
                android:id="@+id/skeletonBeneficiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:visibility="visible">

                <View
                    android:layout_width="140dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_skeleton" />

            </LinearLayout>

            <!-- Beneficiary Content -->
            <LinearLayout
                android:id="@+id/cardBeneficiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <EditText
                    android:id="@+id/etBeneficiaryName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Nume și prenume"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/white_50"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Suma"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Amount Skeleton -->
            <LinearLayout
                android:id="@+id/skeletonAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="visible">

                <View
                    android:layout_width="80dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_skeleton" />

            </LinearLayout>

            <!-- Amount Content -->
            <LinearLayout
                android:id="@+id/cardAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="0,00"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/white_50"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/ivFlagAmount"
                    android:layout_width="24dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/flag_ro" />

                <TextView
                    android:id="@+id/tvCurrency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    tools:text="RON" />

            </LinearLayout>

            <!-- Error Message -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/error_red"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Fonduri insuficiente"
                tools:visibility="visible" />

            <!-- Conversion Info (if different currencies) -->
            <LinearLayout
                android:id="@+id/layoutConversion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingHorizontal="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_flash"
                        app:tint="@color/accent_soft_blue" />

                    <TextView
                        android:id="@+id/tvExchangeRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/accent_soft_blue"
                        android:textSize="13sp"
                        tools:text="1 RON = 0,20 EUR" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="·"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvConvertedAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="Destinatarul primește ~20,00 EUR" />

                </LinearLayout>

            </LinearLayout>

            <!-- Description (optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Descriere (opțional)"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Description Skeleton -->
            <LinearLayout
                android:id="@+id/skeletonDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:visibility="visible">

                <View
                    android:layout_width="120dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_skeleton" />

            </LinearLayout>

            <!-- Description Content -->
            <LinearLayout
                android:id="@+id/cardDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_dark"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Ex: Chirie aprilie"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/white_50"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <!-- Transfer Button -->
            <Button
                android:id="@+id/btnTransfer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_button_disabled"
                android:enabled="false"
                android:text="Continuă"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
