<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingHorizontal="4dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Mini Card Preview -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="60dp"
        android:layout_height="42dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.cardview.widget.CardView
            android:id="@+id/miniCardContainer"
            android:layout_width="48dp"
            android:layout_height="32dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Blocked indicator -->
                <View
                    android:id="@+id/cardPreviewBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_card_green" />

                <View
                    android:id="@+id/blockedIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#80000000"
                    android:visibility="gone" />

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- Card brand icon - outside mini card -->
        <ImageView
            android:id="@+id/ivCardBrandMini"
            android:layout_width="36dp"
            android:layout_height="17dp"
            android:adjustViewBounds="true"
            android:elevation="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/visa_logo"
            android:translationX="8dp"
            android:translationY="3dp"
            app:layout_constraintBottom_toBottomOf="@id/miniCardContainer"
            app:layout_constraintEnd_toEndOf="@id/miniCardContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Card Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Virtual Green" />

        <TextView
            android:id="@+id/tvCardInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/white_60"
            android:textSize="13sp"
            tools:text="••1234, 03/29" />

    </LinearLayout>

    <!-- Status indicator -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white_40"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Blocat" />

    <!-- Arrow -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/white_40" />

</LinearLayout>