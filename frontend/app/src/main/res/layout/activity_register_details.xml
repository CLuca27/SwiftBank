<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_splash_background">

    <com.example.swiftbank.views.ParticlesView
        android:id="@+id/particlesView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_icon_circle_subtle"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="@string/inapoi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="4dp"
                android:text="Completează\ndatele personale"
                android:textColor="@color/white"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Introdu datele exact ca în actul de identitate"
                android:textColor="@color/white_70"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/register_input_background"
                android:hint="Prenume"
                android:inputType="textPersonName|textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white_50"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/register_input_background"
                android:hint="Nume"
                android:inputType="textPersonName|textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white_50"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etCnp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/register_input_background"
                android:hint="CNP (13 cifre)"
                android:inputType="number"
                android:maxLength="13"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white_50"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/white_20" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Adresa de domiciliu"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/register_input_background"
                android:hint="Caută adresa..."
                android:inputType="textPostalAddress"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:paddingHorizontal="16dp"
                android:drawableEnd="@drawable/ic_search"
                android:drawableTint="@color/white_50"
                android:drawablePadding="8dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white_50"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/addressFieldsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/etStreet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/register_input_background"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:includeFontPadding="true"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="9dp"
                    android:textColor="@color/white"
                    android:textSize="15sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false">
                    <TextView
                        android:id="@+id/etCity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/register_input_background"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:includeFontPadding="true"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="9dp"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/etCounty"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/register_input_background"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:includeFontPadding="true"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="9dp"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/etPostalCode"
                    android:layout_width="140dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/register_input_background"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/white"
                    android:textSize="15sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAlignment="center"
                android:textColor="#FF5252"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:alpha="0.5"
                android:background="@drawable/btn_primary"
                android:enabled="false"
                android:text="@string/continua"
                android:textAllCaps="false"
                android:textColor="@color/green_dark" />
        </LinearLayout>
    </ScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/suggestionsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:visibility="gone"
        app:cardBackgroundColor="#1A3C2A"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSuggestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxHeight="250dp"
            android:paddingVertical="8dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true" />
    </androidx.cardview.widget.CardView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone">
        <ProgressBar android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:indeterminateTint="@color/white" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
